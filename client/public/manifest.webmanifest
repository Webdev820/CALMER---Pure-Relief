{
  "name": "CALMER — Pure Relief",
  "short_name": "CALMER",
  "description": "Premium cannabis wellness delivery. Breathe, Unwind, Elevate. Shop, track live deliveries, and vibe with the CALMER team.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#0A0A0A",
  "background_color": "#0A0A0A",
  "lang": "en",
  "dir": "ltr",
  "categories": ["shopping", "health", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Shop Products",
      "short_name": "Shop",
      "description": "Browse the CALMER catalog",
      "url": "/shop?source=pwa",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "description": "Track your live deliveries",
      "url": "/shop/orders?source=pwa",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "CALMER VIBE",
      "short_name": "Vibe",
      "description": "Chat with the CALMER team",
      "url": "/shop/vibe?source=pwa",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Admin Control Center",
      "short_name": "Admin",
      "description": "Manage orders, products and live tracking",
      "url": "/admin?source=pwa",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    { "src": "/assets/products-grid.jpg", "sizes": "1280x720", "type": "image/jpeg", "form_factor": "wide", "label": "CALMER product catalog" },
    { "src": "/assets/mobile-guide.jpg", "sizes": "720x1280", "type": "image/jpeg", "form_factor": "narrow", "label": "CALMER mobile experience" }
  ],
  "prefer_related_applications": false
}
