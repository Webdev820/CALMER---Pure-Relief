# CALMER Backend Environment Variables
PORT=5000
# MongoDB (PandaStack MongoDB / MongoDB Atlas free tier). If unset, dev falls back to in-memory MongoDB.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/calmer
JWT_SECRET=replace-with-long-random-secret
# Frontend origin for CORS (Netlify URL in production)
CLIENT_ORIGIN=http://localhost:3000
# PayPal (production payment processing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
